# ============================================================================
# 云枢智学 · 基础设施环境变量模板
#
# 使用方法（在 deploy 目录下）：
#   PowerShell: Copy-Item env\.env.example .env
#   Bash:       cp env/.env.example .env
# 然后按需修改 deploy/.env，再执行 docker compose up -d。
#
# 注意：
#   1. 密码请使用字母、数字、下划线、连字符，避免 @ : / # ? % 等需要
#      URL 编码的字符，否则 JDBC / Redis 连接串解析会出错。
#   2. deploy/.env 含密钥，不得提交到代码仓库（见 deploy/.gitignore）。
#   3. 生产环境必须替换全部默认口令。
# ============================================================================

# ===== 镜像 =====
# 国内网络拉取失败时，可替换为镜像站地址，例如：
#   MYSQL_IMAGE=docker.m.daocloud.io/library/mysql:8.0
#   REDIS_IMAGE=docker.m.daocloud.io/library/redis:7.2-alpine
#   MINIO_IMAGE=docker.m.daocloud.io/bitnamilegacy/minio:latest
#   MC_IMAGE=docker.m.daocloud.io/bitnamilegacy/minio-client:latest
#
# 关于 MinIO：官方社区版镜像已停止公开分发（minio/minio、minio/mc 均无法拉取，
# dl.min.io 返回 410），因此改用 Bitnami 冻结镜像 bitnamilegacy/minio（内置
# MinIO 2025.5.24 + mc）。S3 API 不变，后续换回官方或其他 S3 存储只需改这里。
MYSQL_IMAGE=mysql:8.0
REDIS_IMAGE=redis:7.2-alpine
MINIO_IMAGE=bitnamilegacy/minio:latest
MC_IMAGE=bitnamilegacy/minio-client:latest

# ===== MySQL 8.0 =====
# 库名固定为 yszx（03.数据库设计.md 已确认），schema.sql 中同样写死
MYSQL_ROOT_PASSWORD=YszxRoot_2026
MYSQL_DATABASE=yszx
MYSQL_USER=yszx
MYSQL_PASSWORD=YszxApp_2026
MYSQL_PORT=3306

# ===== Redis 7 =====
REDIS_PASSWORD=YszxRedis_2026
REDIS_PORT=6379

# ===== MinIO =====
# ROOT_USER 即 S3 Access Key，ROOT_PASSWORD 即 Secret Key（至少 8 位）
MINIO_ROOT_USER=yszxminio
MINIO_ROOT_PASSWORD=YszxMinio_2026
# 业务桶名，首次启动由 minio-init 自动创建
MINIO_BUCKET=yszx-files
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# 是否启用 9001 内置 Web 控制台（Bitnami 镜像默认 off，这里默认打开便于开发）
MINIO_BROWSER=on
